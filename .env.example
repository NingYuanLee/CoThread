DATABASE_URL=mysql://cothread:CHANGE_ME@127.0.0.1:3307/cothread
# Cloud MySQL: set the URL, migrate existing data, and enable TLS.
DATABASE_SSL=false
DATABASE_SSL_CA=
HOST=127.0.0.1
PORT=3100
APP_ORIGIN=http://localhost:3100
COOKIE_SECURE=false
# Optional: stable 32-byte base64 key for encrypted, viewable account tokens.
# When unset, a key is generated in .local/credential-encryption.key; retain it across deployments.
CREDENTIAL_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@cothread.local
ADMIN_PASSWORD=CHANGE_ME
# ACS is the only execution provider. No local execution fallback.
E2B_API_KEY=
E2B_DOMAIN=
E2B_API_URL=
E2B_SANDBOX_URL=
E2B_TEMPLATE=code-interpreter
E2B_TIMEOUT_MS=300000
# Optional DSH-ready ACS image; see docs/architecture.md.
DSH_ENABLED=false
SUMMARY_MODE=direct
CHAT_MODEL=deepseek-v4-flash
# For existing Node 20 templates, install pinned Node and DSH inside the sandbox on demand.
DSH_BOOTSTRAP=false
DEEPSEEK_API_KEY=
