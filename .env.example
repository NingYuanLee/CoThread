# Local secrets and service connections. Never commit the real .env file.
DATABASE_URL=mysql://cothread:CHANGE_ME@127.0.0.1:3307/cothread
# npm run connector:build 内嵌到连接器的默认服务地址（不填为线上地址）。一般无需修改：
# 连接器界面的「服务地址」栏随时可改（如本地验证填 npm run dev 的 http://localhost:3100，/api 与 /mcp 由开发网关转发），改后重新授权即可。
# CONNECTOR_SERVER_URL=http://localhost:3100
# 集成测试专用库（会整库清表）。cothread_dev 受保护，测试必须指向独立库如 cothread_test。
# 测试会清空并重建目标库中的全部表，绝不能指向生产库。
# TEST_DATABASE_URL=mysql://cothread_test:CHANGE_ME@db.example.com:3306/cothread_test
# Local services use .local/sandboxes; EdgeOne Makers uses its injected sandbox.
# OpenAI Responses compatible model services for the three Xiaoxiang levels.
KNOWLEDGE_MODEL_BASE_URL=
KNOWLEDGE_MODEL_API_KEY=
KNOWLEDGE_MODEL=
COORDINATOR_MODEL_BASE_URL=
COORDINATOR_MODEL_API_KEY=
COORDINATOR_MODEL=
EXECUTOR_MODEL_BASE_URL=
EXECUTOR_MODEL_API_KEY=
EXECUTOR_MODEL=
# Generated by npm run setup; preserve this value across deployments.
CREDENTIAL_ENCRYPTION_KEY=
# 可选：云端空库初始化超级管理员（本地通常用 .local/initial-admin.json）。
# ADMIN_EMAIL=admin@cothread.local
# ADMIN_PASSWORD=
# Dedicated bearer token used by the scheduled project-memory maintenance request.
MEMORY_MAINTENANCE_TOKEN=
# Optional JSON endpoint. Use {ip} as the IP placeholder; supported response fields:
# country_name/country, region_name/region/province, city, district/county.
IP_GEOLOCATION_URL=
IP_GEOLOCATION_TOKEN=
# SMTP connection URL used for registration, email binding, and password recovery.
# Example: smtps://account%40example.com:URL_ENCODED_PASSWORD@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=
