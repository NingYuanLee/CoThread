# 本地与 ECS 共用。Never commit the real .env file. 部署到 ECS 时拷到 /opt/cothread/.env。
# 内外网自动判断：阿里云 ECS 用 INTERNAL，本机用 PUBLIC。可选 DATABASE_ENDPOINT=public|internal 强制。

# —— 正式库（地址：host:port/dbname）——
DATABASE_HOST_INTERNAL=rm-xxxxx.rwlb.rds.aliyuncs.com:3306/cothread
DATABASE_HOST_PUBLIC=rm-xxxxxuo.rwlb.rds.aliyuncs.com:3306/cothread
# 账号密码：user:password（仅按第一个冒号拆分）
DATABASE_AUTH=cothread_ecs:CHANGE_ME

# —— 测试库（npm test 会整库清表；须为独立库，勿与正式库同名）——
TEST_DATABASE_HOST_INTERNAL=rm-xxxxx.rwlb.rds.aliyuncs.com:3306/cothread_test
TEST_DATABASE_HOST_PUBLIC=rm-xxxxxuo.rwlb.rds.aliyuncs.com:3306/cothread_test
TEST_DATABASE_AUTH=cothread_ecs:CHANGE_ME

# 监听 0.0.0.0:3100、站点 https://cothread.z2l.top、Cookie Secure（仅 HTTPS）已在代码写死。
KNOWLEDGE_MODEL_BASE_URL=
KNOWLEDGE_MODEL_API_KEY=
KNOWLEDGE_MODEL=
COORDINATOR_MODEL_BASE_URL=
COORDINATOR_MODEL_API_KEY=
COORDINATOR_MODEL=
EXECUTOR_MODEL_BASE_URL=
EXECUTOR_MODEL_API_KEY=
EXECUTOR_MODEL=
# 账号令牌加密密钥：须人工配置并长期固定；禁止改动/重生成，否则已有令牌无法解密。
CREDENTIAL_ENCRYPTION_KEY=
# ADMIN_EMAIL=admin@cothread.local
# ADMIN_PASSWORD=
# 记忆维护入口 Bearer：须人工配置并长期固定；改动后须同步所有调用方。
MEMORY_MAINTENANCE_TOKEN=
SMTP_URL=
EMAIL_FROM=
