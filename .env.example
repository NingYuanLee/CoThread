# Local secrets and service connections. Never commit the real .env file.
DATABASE_URL=mysql://cothread:CHANGE_ME@127.0.0.1:3307/cothread
# Local development only: run commands on this machine inside .local/sandboxes.
LOCAL_SANDBOX_ENABLED=false
LOCAL_SANDBOX_ROOT=.local/sandboxes
# OpenAI Responses compatible model services for the three Xiaoxiang levels.
KNOWLEDGE_MODEL_PROVIDER=
KNOWLEDGE_MODEL_BASE_URL=
KNOWLEDGE_MODEL_API_KEY=
KNOWLEDGE_MODEL_NAME=
KNOWLEDGE_MODEL_REASONING_EFFORT=medium
COORDINATOR_MODEL_PROVIDER=
COORDINATOR_MODEL_BASE_URL=
COORDINATOR_MODEL_API_KEY=
COORDINATOR_MODEL_NAME=
COORDINATOR_MODEL_REASONING_EFFORT=medium
EXECUTOR_MODEL_PROVIDER=
EXECUTOR_MODEL_BASE_URL=
EXECUTOR_MODEL_API_KEY=
EXECUTOR_MODEL_NAME=
EXECUTOR_MODEL_REASONING_EFFORT=medium
# Generated by npm run setup; preserve this value across deployments.
CREDENTIAL_ENCRYPTION_KEY=
# Optional JSON endpoint. Use {ip} as the IP placeholder; supported response fields:
# country_name/country, region_name/region/province, city, district/county.
IP_GEOLOCATION_URL=
IP_GEOLOCATION_TOKEN=
# SMTP service used for registration, email binding, and password recovery codes.
# QQ Mail example: use your full QQ email as SMTP_USER and an SMTP authorization
# code as SMTP_PASSWORD. EMAIL_FROM can be: Cothread <your-account@qq.com>
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
