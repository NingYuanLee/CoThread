{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "shared/**/*.js",
    "shared/**/*.mjs",
    "shared/**/*.mts",
    "shared/**/*.d.ts",
    "shared/**/*.d.mts"
  ]
}
